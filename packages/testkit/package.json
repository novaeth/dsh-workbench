{
  "name": "@dsh-workbench/testkit",
  "version": "0.0.0",
  "private": true,
  "description": "Private test kit: world model, projections and fixture adapters for the workbench; never shipped.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --outfile=dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --testTimeout=20000"
  },
  "dependencies": {
    "@dsh-workbench/shared": "workspace:*"
  },
  "devDependencies": {
    "esbuild": "^0.28.2",
    "typescript": "^5.9.3",
    "vitest": "^5.0.2",
    "@types/node": "^24.19.0"
  }
}
