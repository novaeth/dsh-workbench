{
  "name": "@dsh-workbench/module-tools",
  "version": "0.3.11",
  "description": "模块包的构建与门禁工具：build（单文件 ESM 宿主侧 + 套 loader 壳的浏览器侧）、check（契约/产物边界/源码边界/卡片渲染）。模块包不再各带一份构建脚本。",
  "license": "MIT",
  "type": "module",
  "bin": {
    "dsh-wb-module": "./bin/dsh-wb-module.mjs"
  },
  "exports": {
    ".": "./src/index.mjs",
    "./arch": "./src/arch.mjs",
    "./lint": "./src/lint.mjs"
  },
  "files": [
    "bin",
    "src",
    "template",
    "template-diy"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "selfcheck": "node scripts/selfcheck/index.mjs"
  },
  "dependencies": {
    "@arch-guard/core": "^0.11.0",
    "@dsh-workbench/shared": "workspace:*",
    "@eslint/js": "^10.0.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.11.0",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "typescript": "5.9.3",
    "typescript-eslint": "^8.71.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaeth/dsh-workbench.git",
    "directory": "packages/module-tools"
  },
  "homepage": "https://github.com/novaeth/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/novaeth/dsh-workbench/issues"
  }
}
