{
  "name": "@dsh-workbench/adapter-probe",
  "version": "1.2.8-beta.2",
  "description": "Workbench adapter-probe adapter.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --testTimeout=20000",
    "arch": "arch-guard",
    "check:runtimes": "node ../../scripts/check-adapter-package.mjs --runtime",
    "coverage": "vitest run --coverage --coverage.reporter=text-summary --testTimeout=20000"
  },
  "dependencies": {
    "@dsh-workbench/adapter-profile": "workspace:*",
    "@dsh-workbench/adapter-runtime": "workspace:*",
    "@dsh-workbench/adapter-supply": "workspace:*",
    "@dsh-workbench/shared": "workspace:*",
    "proper-lockfile": "^4.1.2"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "vitest": "^5.0.2",
    "dayjs": "^1.11.23",
    "@vitest/coverage-v8": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
