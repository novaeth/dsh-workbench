{
  "name": "@dsh-workbench/core",
  "version": "1.1.6",
  "description": "个人工作台：Agent 工作台（左栏 + 常驻对话 + 自研右侧数据面板）。",
  "type": "module",
  "icon": "./icon.svg",
  "exports": {
    ".": {
      "types": "./dist/types/app/host.d.ts",
      "default": "./dist/host/index.js"
    },
    "./client": {
      "types": "./dist/types/app/client.d.ts",
      "default": "./client.js"
    },
    "./package.json": "./package.json",
    "./contract": {
      "types": "./dist/types/kernel/contract/index.d.ts"
    },
    "./client/esm": {
      "types": "./dist/types/app/client.d.ts",
      "default": "./dist/client/index.js"
    }
  },
  "bin": {
    "dsh-workbench": "./bin/dsh-workbench"
  },
  "files": [
    "dist",
    "client.js",
    "cordis.patch.yml",
    "icon.svg",
    "bin",
    "profile",
    "skills",
    "preset",
    "scripts/create-workbench.mjs",
    "scripts/clone-profile.mjs",
    "scripts/patch-blocks.mjs",
    "scripts/share-data-root.mjs",
    "scripts/seed-profile.sh",
    "scripts/seed-workshop.sh",
    "README.md"
  ],
  "meta": {
    "title": "Workbench",
    "description": "个人工作台"
  },
  "scripts": {
    "build": "node scripts/build.mjs && node scripts/build-types.mjs",
    "build:host": "node scripts/build.mjs host",
    "build:client": "node scripts/build.mjs client",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsconfig.tsbuildinfo",
    "prepare": "node scripts/build-types.mjs",
    "arch": "arch-guard",
    "selfcheck": "node scripts/selfcheck/index.mjs",
    "check:runtimes": "node scripts/check-runtimes.mjs",
    "check:release-artifacts": "node scripts/check-release-artifacts.mjs",
    "check": "pnpm -w run check",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "dev": "node scripts/dev.mjs",
    "dev:desktop": "node scripts/dev.mjs --desktop",
    "prepack": "WB_RELEASE=1 node scripts/build.mjs && node scripts/build-types.mjs",
    "prepublishOnly": "pnpm -w run check",
    "build:types": "node scripts/build-types.mjs",
    "check:adapter-defaults": "node scripts/check-adapter-defaults.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": [
        "./cordis.patch.yml",
        "./preset/diy.patch.yml"
      ]
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-api-session-controller"
      ]
    }
  },
  "engines": {
    "dsh": ">=0.2.1-rc.2"
  },
  "peerDependencies": {
    "react": "*"
  },
  "peerDependenciesMeta": {
    "react": {
      "optional": true
    }
  },
  "devDependencies": {
    "@arch-guard/core": "^0.11.1",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.1-rc.2",
    "@types/node": "^24.19.0",
    "@types/proper-lockfile": "^4.1.4",
    "@types/react": "^19.3.0",
    "@types/which": "^3.0.4",
    "@types/write-file-atomic": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "esbuild": "^0.28.2",
    "react": "^19.3.0",
    "typescript": "5.9",
    "vite": "^8.3.1",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@dsh-workbench/shared": "workspace:*",
    "dayjs": "^1.11.23",
    "execa": "^10.2.0",
    "prompts": "^2.4.2",
    "proper-lockfile": "^4.1.2",
    "which": "^7.0.0",
    "write-file-atomic": "^8.0.0",
    "@dsh-workbench/adapters-default": "workspace:*"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaeth/dsh-workbench.git",
    "directory": "packages/core"
  },
  "homepage": "https://github.com/novaeth/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/novaeth/dsh-workbench/issues"
  }
}
