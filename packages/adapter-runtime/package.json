{
  "name": "@dsh-workbench/adapter-runtime",
  "version": "1.1.14-beta.0",
  "description": "Opencli, browser and data runtime adapters.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "channel",
    "!channel/__tests__/**",
    "bin"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run --testTimeout=20000",
    "coverage": "vitest run --coverage --coverage.reporter=text-summary --testTimeout=20000",
    "arch": "arch-guard",
    "check:runtimes": "node ../../scripts/check-adapter-package.mjs --runtime"
  },
  "dependencies": {
    "@dsh-workbench/shared": "workspace:*",
    "execa": "^10.2.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "@vitest/coverage-v8": "^5.0.2",
    "vitest": "^5.0.2"
  },
  "publishConfig": {
    "access": "public"
  },
  "license": "MIT"
}
