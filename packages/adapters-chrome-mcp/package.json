{
  "name": "@dsh-workbench/adapters-chrome-mcp",
  "version": "1.1.14-beta.1",
  "private": true,
  "description": "实验适配器集合：把 Chrome MCP server（stdio）当运行时，用来验收外壳与适配器的解耦。",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@dsh-workbench/shared": "workspace:*",
    "execa": "^10.2.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "arch": "arch-guard",
    "check:runtimes": "node ../../scripts/check-adapter-package.mjs --runtime",
    "coverage": "vitest run --coverage --coverage.reporter=text-summary --testTimeout=20000"
  },
  "devDependencies": {
    "@types/node": "^24.19.0",
    "vitest": "^5.0.2",
    "@vitest/coverage-v8": "^5.0.2"
  }
}
