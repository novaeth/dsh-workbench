{
  "name": "@dsh-workbench/shared",
  "version": "1.2.8-beta.1",
  "description": "工作台与模块共享的纯代码与契约类型：类型、纯逻辑、哑组件、平台解析。宿主侧的东西从 /host 进（不影响浏览器产物）。",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./host": {
      "types": "./dist/host.d.ts",
      "default": "./dist/host.js"
    },
    "./testing": {
      "types": "./dist/testing.d.ts",
      "default": "./dist/testing.js"
    },
    "./contract/*": {
      "types": "./dist/contract/*.d.ts",
      "default": "./dist/contract/*.js"
    }
  },
  "files": [
    "src",
    "dist"
  ],
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "node scripts/gen-release-packages.mjs && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "typecheck": "tsc --noEmit --incremental --tsBuildInfoFile node_modules/.cache/tsconfig.tsbuildinfo",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "barrels": "node scripts/barrels.mjs",
    "prepack": "node scripts/gen-release-packages.mjs && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "prepare": "node scripts/gen-release-packages.mjs && tsc -p tsconfig.build.json && node scripts/copy-css.mjs",
    "selfcheck": "node scripts/check-state.mjs && node scripts/gen-release-packages.mjs --check",
    "arch:report": "arch-guard --report-only",
    "arch": "arch-guard"
  },
  "peerDependencies": {
    "react": "*"
  },
  "devDependencies": {
    "@arch-guard/core": "^0.11.3",
    "@deepseek-ai/dsh-agent": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-preset": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-agent-preset-registry": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-gateway": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remote-access": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-remotes": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-session-controller": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-api-workspace-controller": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-app-boot": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-locale": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-shortcuts": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-store": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-commands": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-context-menu": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-conversation": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-input-trigger": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-layout": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-primitives": "0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-renderer": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-session": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-settings": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-sidebar-right": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-slots": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-client-ui-workspace": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-hmr": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-home-paths": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-host-webserver": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-llm": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-mcp-client": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-package-manifest": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-plugin-manager": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-session": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-session-projection": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-shell": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-subagent": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-system-prompt": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-tools": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-user-approval": "^0.2.2-rc.2",
    "@deepseek-ai/dsh-workspace": "^0.2.2-rc.2",
    "@types/node": "^24.19.0",
    "@types/react": "^19.0.0",
    "@types/semver": "^7.8.0",
    "@types/write-file-atomic": "^4.0.3",
    "@vitest/coverage-v8": "^5.0.2",
    "react": "^18.0.0",
    "typescript": "5.9",
    "vitest": "^5.0.2"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.1.0",
    "@deepseek-ai/cordis-plugin-loader": "1.1.0",
    "dayjs": "^1.11.23",
    "execa": "^10.2.0",
    "semver": "^7.8.5",
    "write-file-atomic": "^8.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/novaeth/dsh-workbench.git",
    "directory": "packages/shared"
  },
  "homepage": "https://github.com/novaeth/dsh-workbench#readme",
  "bugs": {
    "url": "https://github.com/novaeth/dsh-workbench/issues"
  }
}
